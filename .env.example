# Local runtime configuration. Never commit real credentials.
NISSE_RUNTIME_HOST=127.0.0.1
NISSE_RUNTIME_PORT=4317
NISSE_ALLOWED_EXTENSION_ORIGIN=chrome-extension://your-extension-id

# ZenTao local API test values. Copy this file to .env and fill real values.
# Never commit .env or share the password.
ZENTAO_ENDPOINT=https://your-zentao.example.com
ZENTAO_ACCOUNT=your-account
ZENTAO_PASSWORD=your-password

# Optional model configuration for Chat → Agent tool calling.
MODEL_API_KEY=your-model-api-key
MODEL_PROVIDER=deepseek
MODEL_ENDPOINT=https://api.deepseek.com
MODEL_NAME=deepseek-chat
